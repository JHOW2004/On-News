{
  
  "framework": "vite",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/daily-news",
      "schedule": "0 21 * * *"
    }
  ],
  
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
